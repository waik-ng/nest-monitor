# Copy to .env and fill in. Never commit .env — it holds secrets.
# On the Pi: cp config.env.example .env  then edit with nano .env

# --- Google Smart Device Management (Device Access) ---
# Device Access project ID = UUID from https://console.nest.google.com/device-access
# (NOT your Google Cloud project ID)
SDM_PROJECT_ID=
SDM_CLIENT_ID=
SDM_CLIENT_SECRET=
SDM_REFRESH_TOKEN=
# Optional: leave blank to auto-discover the first thermostat in the project.
# Find it via: GET https://smartdevicemanagement.googleapis.com/v1/enterprises/<SDM_PROJECT_ID>/devices
SDM_DEVICE_ID=

# --- Gmail alerts (SMTP with an App Password) ---
# GMAIL_USER = the Gmail address that SENDS the alert.
# GMAIL_APP_PASSWORD = 16-char App Password (Google Account > Security >
#   2-Step Verification > App passwords). NOT your normal Gmail password.
# ALERT_EMAIL = where alerts go (defaults to GMAIL_USER if blank).
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL=

DEVICE_NAME=Nest Thermostat
TEMP_UNIT=F

# --- Local storage on the Pi ---
# Defaults are nest_data.db / nest_monitor.log next to the script.
# DB_PATH=/home/pi/nest-monitor/nest_data.db
# LOG_PATH=/home/pi/nest-monitor/nest_monitor.log

# --- Detection thresholds (tune to your system) ---
SHORT_CYCLE_MINUTES=10
MAX_CYCLES_PER_HOUR=4
LONG_RUN_MINUTES=90
LONG_RUN_MIN_PROGRESS_F=0.5
OFF_NO_PROGRESS_MINUTES=120
OFF_TEMP_GAP_F=3.0
ALERT_COOLDOWN_MINUTES=60
OFFLINE_AFTER_FAILURES=3
